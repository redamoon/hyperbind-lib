{
  "name": "@hyperbind-lib/react",
  "version": "0.2.10",
  "description": "React hooks and components for HyperBind",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "keyboard",
    "keybind",
    "shortcut"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "dependencies": {
    "@hyperbind-lib/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "typescript": "^5.6.0",
    "tsup": "^8.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^14.3.1",
    "@types/react-dom": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
