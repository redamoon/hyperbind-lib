{
  "name": "@hyperbind-lib/core",
  "version": "0.2.10",
  "description": "Core keyboard binding manager for HyperBind",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "keywords": ["keyboard", "keybind", "shortcut"],
  "author": "redamoon",
  "license": "MIT",
  "homepage": "https://redamoon.github.io/hyperbind-lib/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redamoon/hyperbind-lib.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/redamoon/hyperbind-lib/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsup": "^8.0.0"
  }
}
