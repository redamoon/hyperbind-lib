{
  "name": "@hyperbind-lib/vue",
  "version": "0.2.10",
  "description": "Vue 3 composables and components for HyperBind",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "vue",
    "vue3",
    "keyboard",
    "keybind",
    "shortcut"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@hyperbind-lib/core": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vue": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.9.0",
    "vue-tsc": "^2.2.12",
    "@testing-library/vue": "^8.1.0",
    "@vue/test-utils": "^2.4.6"
  }
}
