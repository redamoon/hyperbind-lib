{
  "name": "@hyperbind-lib/vue",
  "version": "0.2.10",
  "description": "Vue 3 composables and components for HyperBind",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "keywords": ["vue", "vue3", "keyboard", "keybind", "shortcut"],
  "author": "redamoon",
  "license": "MIT",
  "homepage": "https://redamoon.github.io/hyperbind-lib/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redamoon/hyperbind-lib.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/redamoon/hyperbind-lib/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@hyperbind-lib/core": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vue": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.9.0",
    "vue-tsc": "^2.2.12"
  }
}
