{
  "$schema": "https://cursor.com/agent/hooks.schema.json",
  "version": 1,
  "hooks": [
    {
      "name": "Update README on reserved keys change",
      "event": "onFilesChanged",
      "when": {
        "patterns": [
          "packages/react/src/reservedKeys.ts",
          "packages/core/src/PresetKeybinds.ts"
        ]
      },
      "run": [
        { "type": "shell", "command": "pnpm update-readme", "cwd": "${workspaceRoot}" }
      ]
    },
    {
      "name": "Update README before commit",
      "event": "onPreCommit",
      "run": [
        { "type": "shell", "command": "pnpm update-readme", "cwd": "${workspaceRoot}" },
        { "type": "shell", "command": "git add README.md examples/react/README.md", "cwd": "${workspaceRoot}" }
      ]
    },
    {
      "name": "Manual command: Update README",
      "event": "onCommand",
      "when": { "command": "docs:update" },
      "run": [
        { "type": "shell", "command": "pnpm docs:update", "cwd": "${workspaceRoot}" }
      ]
    },
    {
      "name": "Manual command: Release",
      "event": "onCommand",
      "when": { "command": "release" },
      "run": [
        { "type": "shell", "command": "./scripts/release.sh", "cwd": "${workspaceRoot}" }
      ]
    }
  ]
}

