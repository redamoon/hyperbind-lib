{
  "name": "hyperbind-lib",
  "description": "HyperBind - Keyboard binding library for React, Vue and VanillaJS",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:core": "pnpm --filter @hyperbind-lib/core build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:core && pnpm -r --filter \"./packages/*\" typecheck",
    "update-readme": "node scripts/update-readme.mjs",
    "docs:update": "node scripts/update-readme.mjs",
    "build:examples": "pnpm build:react && pnpm build:vue",
    "build:react": "cd examples/react && pnpm build",
    "build:vue": "cd examples/vue && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^9.4.3"
  },
  "volta": {
    "node": "20.18.0",
    "pnpm": "10.0.0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
